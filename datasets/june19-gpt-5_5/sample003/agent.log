ails\" />\n+    <schematicsection name=\"driver\" displayName=\"LM3409 LED Driver\" />\n+    <schematicsection name=\"control\" displayName=\"Flicker-Free Dimming Control\" />\n+    <schematicsection name=\"leds\" displayName=\"Ring LED Output\" />\n+\n+    <connector\n+      name=\"J1\"\n+      standard=\"usb_c\"\n+      schSectionName=\"input\"\n+      connections={{\n+        VBUS1: \"net.VBUS_USB\",\n+        VBUS2: \"net.VBUS_USB\",\n+        VBUS3: \"net.VBUS_USB\",\n+        VBUS4: \"net.VBUS_USB\",\n+        GND1: \"net.GND\",\n+        GND2: \"net.GND\",\n+        GND3: \"net.GND\",\n+        GND4: \"net.GND\",\n+        CC1: \"net.CC1\",\n+        CC2: \"net.CC2\",\n+        DP1: \"net.USB_D_P\",\n+        DP2: \"net.USB_D_P\",\n+        DM1: \"net.USB_D_N\",\n+        DM2: \"net.USB_D_N\",\n+      }}\n+    />\n+    <fuse\n+      name=\"F1\"\n+      currentRating=\"5A\"\n+      footprint=\"1206\"\n+      schSectionName=\"input\"\n+      supplierPartNumbers={{ jlcpcb: \"C70076\" }}\n+      connections={{ pin1: \"net.VBUS_USB\", pin2: \"net.PPVAR\" }}\n+    />\n+    <diode\n+      name=\"D1\"\n+      footprint=\"sod323\"\n+      schDisplayValue=\"SMBJ24CA TVS\"\n+      schSectionName=\"input\"\n+      supplierPartNumbers={{ jlcpcb: \"C181171\" }}\n+      connections={{ anode: \"net.GND\", cathode: \"net.VBUS_USB\" }}\n+    />\n+    <capacitor\n+      name=\"C1\"\n+      capacitance=\"10uF\"\n+      footprint=\"1206\"\n+      schSectionName=\"input\"\n+      supplierPartNumbers={{ jlcpcb: \"C13585\" }}\n+      connections={{ pin1: \"net.PPVAR\", pin2: \"net.GND\" }}\n+    />\n+    <capacitor\n+      name=\"C2\"\n+      capacitance=\"100nF\"\n+      footprint=\"0603\"\n+      schSectionName=\"input\"\n+      supplierPartNumbers={{ jlcpcb: \"C14663\" }}\n+      connections={{ pin1: \"net.PPVAR\", pin2: \"net.GND\" }}\n+    />\n+\n+    <chip\n+      name=\"U1\"\n+      footprint=\"qfn24\"\n+      schSectionName=\"pd\"\n+      pinLabels={{\n+        pin1: \"CC1\"