", \"EP\"],\n+      },\n+    }}\n+  />\n+)\n+\n+const lm3409Pins = {\n+  pin1: \"VIN\",\n+  pin2: \"VCC\",\n+  pin3: \"EN\",\n+  pin4: \"IADJ\",\n+  pin5: \"COFF\",\n+  pin6: \"GND\",\n+  pin7: \"CSP\",\n+  pin8: \"CSN\",\n+  pin9: \"HG\",\n+  pin10: \"LDRV\",\n+} as const\n+\n+const Lm3409 = (props: ChipProps<typeof lm3409Pins>) => (\n+  <chip\n+    {...props}\n+    manufacturerPartNumber=\"LM3409HVMY/NOPB\"\n+    footprint=\"msop10\"\n+    supplierPartNumbers={jlc(\"C129709\")}\n+    pinLabels={lm3409Pins}\n+    schPinArrangement={{\n+      leftSide: {\n+        direction: \"top-to-bottom\",\n+        pins: [\"VIN\", \"VCC\", \"EN\", \"IADJ\", \"COFF\"],\n+      },\n+      rightSide: {\n+        direction: \"top-to-bottom\",\n+        pins: [\"HG\", \"LDRV\", \"CSP\", \"CSN\", \"GND\"],\n+      },\n+    }}\n+  />\n+)\n+\n export default () => (\n-  <board>\n-    <resistor resistance=\"1k\" footprint=\"0402\" name=\"R1\" />\n-    <capacitor capacitance=\"1000pF\" footprint=\"0402\" name=\"C1\" />\n-    <trace from=\".R1 > .pin1\" to=\".C1 > .pin1\" />\n+  <board width=\"95mm\" height=\"55mm\" layers={2} routingDisabled>\n+    <net name=\"VBUS_RAW\" />\n+    <net name=\"VBUS_PD\" />\n+    <net name=\"VLED_20V\" />\n+    <net name=\"V3_3\" />\n+    <net name=\"V1_2\" />\n+    <net name=\"V2_7\" />\n+    <net name=\"GND\" />\n+    <net name=\"CC1\" />\n+    <net name=\"CC2\" />\n+    <net name=\"I2C_SDA\" />\n+    <net name=\"I2C_SCL\" />\n+    <net name=\"PD_ALERT\" />\n+    <net name=\"PD_RESET\" />\n+    <net name=\"PD_ATTACH\" />\n+    <net name=\"PD_OK\" />\n+    <net name=\"DIM_PWM\" />\n+    <net name=\"DIM_ANALOG\" />\n+    <net name=\"LED_SW\" />\n+    <net name=\"LED_ANODE\" />\n+    <net name=\"LED_CATHODE\" />\n+    <net name=\"SNS_P\" />\n+    <net name=\"SNS_N\" />\n+    <net name=\"COFF\" />\n+    <net name=\"LED_ENABLE\" />\n+\n+    <schematicsection name=\"usb_pd\" displayName=\"USB-C PD Sink Input\" />\n+    <schematicsection name=\"logic\" displayNa