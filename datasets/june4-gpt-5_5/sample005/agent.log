[recv] {"method":"turn/diff/updated","params":{"threadId":"019e938c-1a61-7d82-97d8-f72d6739dcf5","turnId":"019e938c-1a82-7fc0-99de-310ab0cf5af9","diff":"diff --git a/index.circuit.tsx b/index.circuit.tsx\nnew file mode 100644\nindex 0000000000000000000000000000000000000000..073e638b318006dec33c6eb049aa78cf4dda9b99\n--- /dev/null\n+++ b/index.circuit.tsx\n@@ -0,0 +1,354 @@\n+import React from \"react\"\n+import type {} from \"tscircuit\"\n+\n+const rp2040Pins = {\n+  pin1: \"IOVDD1\",\n+  pin2: \"GP0\",\n+  pin3: \"GP1\",\n+  pin4: \"GP2\",\n+  pin5: \"GP3\",\n+  pin6: \"GP4\",\n+  pin7: \"GP5\",\n+  pin8: \"GP6\",\n+  pin9: \"GP7\",\n+  pin10: \"IOVDD2\",\n+  pin11: \"GP8\",\n+  pin12: \"GP9\",\n+  pin13: \"GP10\",\n+  pin14: \"GP11\",\n+  pin15: \"GP12\",\n+  pin16: \"GP13\",\n+  pin17: \"GP14\",\n+  pin18: \"GP15\",\n+  pin19: \"TESTEN\",\n+  pin20: \"XIN\",\n+  pin21: \"XOUT\",\n+  pin22: \"IOVDD3\",\n+  pin23: \"DVDD1\",\n+  pin24: \"SWCLK\",\n+  pin25: \"SWDIO\",\n+  pin26: \"RUN\",\n+  pin27: \"GP16\",\n+  pin28: \"GP17\",\n+  pin29: \"GP18\",\n+  pin30: \"GP19\",\n+  pin31: \"GP20\",\n+  pin32: \"GP21\",\n+  pin33: \"IOVDD4\",\n+  pin34: \"GP22\",\n+  pin35: \"GP23\",\n+  pin36: \"GP24\",\n+  pin37: \"GP25\",\n+  pin38: \"GP26_ADC0\",\n+  pin39: \"GP27_ADC1\",\n+  pin40: \"GP28_ADC2\",\n+  pin41: \"GP29_ADC3\",\n+  pin42: \"IOVDD5\",\n+  pin43: \"ADC_AVDD\",\n+  pin44: \"VREG_VIN\",\n+  pin45: \"VREG_VOUT\",\n+  pin46: \"USB_DM\",\n+  pin47: \"USB_DP\",\n+  pin48: \"USB_VDD\",\n+  pin49: \"IOVDD6\",\n+  pin50: \"DVDD2\",\n+  pin51: \"QSPI_SD3\",\n+  pin52: \"QSPI_SCLK\",\n+  pin53: \"QSPI_SD0\",\n+  pin54: \"QSPI_SD2\",\n+  pin55: \"QSPI_SD1\",\n+  pin56: \"QSPI_SS_N\",\n+  pin57: \"GND\",\n+} as const\n+\n+export default () => (\n+  <board width=\"52mm\" height=\"42mm\" layers={2} routingDisabled>\n+    <net name=\"VBUS\" />\n+    <net name=\"V3_3\" />\n+    <net name=\"V1_1\" />\n+    <net name=\"GND\" />\n+    <net name=\"USB_DP\" />\n+    <net name=\"USB_