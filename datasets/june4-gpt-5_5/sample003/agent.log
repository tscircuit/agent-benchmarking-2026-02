ult () => (\n+  <board width=\"48mm\" height=\"32mm\" layers={2} routingDisabled>\n+    <net name=\"VBUS\" />\n+    <net name=\"V3V3\" />\n+    <net name=\"GND\" />\n+    <net name=\"USB_DP\" />\n+    <net name=\"USB_DM\" />\n+    <net name=\"XIN\" />\n+    <net name=\"XOUT\" />\n+    <net name=\"QSPI_SS_N\" />\n+    <net name=\"QSPI_SCLK\" />\n+    <net name=\"QSPI_SD0\" />\n+    <net name=\"QSPI_SD1\" />\n+    <net name=\"QSPI_SD2\" />\n+    <net name=\"QSPI_SD3\" />\n+    <net name=\"RUN\" />\n+    <net name=\"SWCLK\" />\n+    <net name=\"SWDIO\" />\n+    <net name=\"BOOTSEL\" />\n+    <net name=\"LED\" />\n+\n+    <schematicsection name=\"usb_power\" displayName=\"USB and Power\" />\n+    <schematicsection name=\"mcu\" displayName=\"RP2040 MCU\" />\n+    <schematicsection name=\"clock_flash\" displayName=\"Clock and Flash\" />\n+    <schematicsection name=\"debug_io\" displayName=\"Debug and GPIO\" />\n+\n+    <connector\n+      name=\"J1\"\n+      standard=\"usb_c\"\n+      schSectionName=\"usb_power\"\n+      supplierPartNumbers={{ jlcpcb: [\"C165948\"] }}\n+      connections={{\n+        VBUS1: \"net.VBUS\",\n+        VBUS2: \"net.VBUS\",\n+        GND1: \"net.GND\",\n+        GND2: \"net.GND\",\n+        DP1: \"net.USB_DP\",\n+        DP2: \"net.USB_DP\",\n+        DM1: \"net.USB_DM\",\n+        DM2: \"net.USB_DM\",\n+      }}\n+    />\n+    <chip\n+      name=\"U2\"\n+      footprint=\"sot23_5\"\n+      schSectionName=\"usb_power\"\n+      supplierPartNumbers={{ jlcpcb: [\"C347222\"] }}\n+      pinLabels={{\n+        pin1: \"VIN\",\n+        pin2: \"GND\",\n+        pin3: \"EN\",\n+        pin4: \"NC\",\n+        pin5: \"VOUT\",\n+      }}\n+      schPinArrangement={{\n+        leftSide: { pins: [\"VIN\", \"GND\", \"EN\"], direction: \"top-to-bottom\" },\n+        rightSide: { pins: [\"VOUT\", \"NC\"], direction: \"top-to-bottom\" },\n+      }}\n+      connections={{\n+        VIN: \"net.VBUS\",\n+        GND: \"net.GND\",\n+        EN: \"net.VBUS\",\n+        VOUT: \"net.V3V3\",\n+      }}\n+    />\n+    <capacitor\n+      name=\"C1\"\n+      capacitance=\"10uF\"\n+      footprint=\"0805\"\n+      schSectionName=\"usb_power\"\n+      supplierPartNumbers={{ jlcpcb: [\"C15850\"] }}\n+      connections={{ pin1: \"net.VBUS\", pin2: \"net.GND\" }}\n+    />\n+    <capacitor\n+      name=\"C2\"\n+      capacitance=\"10uF\"\n+      footprint=\"0805\"\n+      schSectionName=\"usb_power\"\n+      supplierPartNumbers={{ jlcpcb: [\"C15850\"] }}\n+      connections={{ pin1: \"net.V3V3\", pin2: \"net.GND\" }}\n+    />\n+\n+    <chip\n+      name=\"U1\"\n+      footprint=\"qfn56\"\n+      schSectionName=\"mcu\"\n+      supplierPartNumbers={{ jlcpcb: [\"C2040\"] }}\n+      pinLabels={rp2040PinLabels}\n+      schPinArrangement={{\n+        topSide: {\n+          pins: [\"IOVDD_0\", \"IOVDD_1\", \"IOVDD_2\", \"IOVDD_3\", \"IOVDD_4\", \"IOVDD_5\"],\n+          direction: \"left-to-right\",\n+        },\n+        bottomSide: {\n+          pins: [\"DVDD_0\", \"DVDD_1\", \"USB_VDD\", \"ADC_AVDD\", \"VREG_VIN\", \"VREG_VOUT\"],\n+          direction: \"left-to-right\",\n+        },\n+        leftSide: {\n+          pins: [\n+            \"GPIO0\",\n+            \"GPIO1\",\n+            \"GPIO2\",\n+            \"GPIO3\",\n+            \"GPIO4\",\n+            \"GPIO5\",\n+            \"GPIO6\",\n+            \"GPIO7\",\n+            \"GPIO8\",\n+            \"GPIO9\",\n+            \"GPIO10\",\n+            \"GPIO11\",\n+            \"GPIO12\",\n+            \"GPIO13\",\n+            \"GPIO14\",\n+            \"GPIO15\",\n+            \"TESTEN\",\n+            \"XIN\",\n+            \"XOUT\",\n+            \"SWCLK\",\n+            \"SWDIO\",\n+            \"RUN\",\n+          ],\n+          direction: \"top-to-bottom\",\n+        },\n+        rightSide: {\n+          pins: [\n+            \"GPIO16\",\n+            \"GPIO17\",\n+            \"GPIO18\",\n+            \"GPIO19\",\n+            \"GPIO20\",\n+            \"GPIO21\",\n+         