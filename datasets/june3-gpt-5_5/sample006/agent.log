nerate schematic SVG outputs during build\n                                  generation\n  --3d-png                        Generate 3D PNG outputs during build\n                                  generation\n  --3d                            Generate 3D PNG outputs during build\n                                  generation\n  --pcb-only                      Generate only PCB SVG outputs during build\n                                  generation\n  --schematic-only                Generate only schematic SVG outputs during\n                                  build generation\n  --kicad-project                 Generate KiCad project directories for each\n                                  successful build output\n  --kicad-project-zip             Generate a zipped KiCad project for each\n                                  successful build output\n  --kicad-library                 Generate KiCad library in dist/kicad-library\n  --kicad-library-name <name>     Specify the name of the KiCad library\n  --preview-gltf                  Generate a GLTF file from the preview\n                                  entrypoint\n  --show-courtyards               Show courtyard outlines in PCB SVG outputs\n  --glbs                          Generate GLB 3D model files for every\n                                  successful build\n  --step                          Generate STEP 3D model files for every\n                                  successful build\n  --profile                       Log per-circuit circuit.json generation time\n                                  during build\n  --kicad-pcm                     Generate KiCad PCM (Plugin and Content\n                                  Manager) assets in dist/pcm\n  --use-cdn-javascript            Use CDN-hosted JavaScript instead of bundled\n                                  standalone file for --site\n  --concurrency <number>          Number of files to build in parallel (default:\n                                  1) (default: \"1\")\n  -