[recv] {"method":"turn/diff/updated","params":{"threadId":"019e8ead-3fe9-7073-8d25-1b277e826e16","turnId":"019e8ead-3ff4-7252-8829-239cc99569de","diff":"diff --git a/index.circuit.tsx b/index.circuit.tsx\nindex 9ec08d87ef9036fe8dac013e6d9e363557c4dcc9..0203f7a40b4d13afed17df1d384dc9c3ce7e9f03\n--- a/index.circuit.tsx\n+++ b/index.circuit.tsx\n@@ -1,7 +1,284 @@\n+import { RP2040 } from \"./imports/RP2040\"\n+\n+const gpioLeft = [\n+  \"GPIO0\",\n+  \"GPIO1\",\n+  \"GPIO2\",\n+  \"GPIO3\",\n+  \"GPIO4\",\n+  \"GPIO5\",\n+  \"GPIO6\",\n+  \"GPIO7\",\n+  \"GPIO8\",\n+  \"GPIO9\",\n+  \"GPIO10\",\n+  \"GPIO11\",\n+  \"GPIO12\",\n+  \"GPIO13\",\n+] as const\n+\n+const gpioRight = [\n+  \"GPIO14\",\n+  \"GPIO15\",\n+  \"GPIO16\",\n+  \"GPIO17\",\n+  \"GPIO18\",\n+  \"GPIO19\",\n+  \"GPIO20\",\n+  \"GPIO21\",\n+  \"GPIO22\",\n+  \"GPIO23\",\n+  \"GPIO24\",\n+  \"GPIO26_ADC0\",\n+  \"GPIO27_ADC1\",\n+  \"GPIO28_ADC2\",\n+  \"GPIO29_ADC3\",\n+] as const\n+\n+const leftHeaderLabels = [\"VBUS\", \"GND\", \"3V3\", ...gpioLeft] as const\n+const rightHeaderLabels = [\"RUN\", \"SWCLK\", \"SWD\", \"GND\", ...gpioRight] as const\n+\n+const powerPins = [\n+  \"IOVDD1\",\n+  \"IOVDD2\",\n+  \"IOVDD3\",\n+  \"IOVDD4\",\n+  \"IOVDD5\",\n+  \"IOVDD6\",\n+  \"USB_VDD\",\n+  \"ADC_AVDD\",\n+  \"VREG_IN\",\n+] as const\n+\n+const decouplers = [\n+  { name: \"C1\", capacitance: \"100nF\", x: -7.2, y: 8.1, schX: -3.6, schY: 4.8 },\n+  { name: \"C2\", capacitance: \"100nF\", x: -4.8, y: 8.1, schX: -2.2, schY: 4.8 },\n+  { name: \"C3\", capacitance: \"100nF\", x: -2.4, y: 8.1, schX: -0.8, schY: 4.8 },\n+  { name: \"C4\", capacitance: \"100nF\", x: 0, y: 8.1, schX: 0.6, schY: 4.8 },\n+  { name: \"C5\", capacitance: \"100nF\", x: 2.4, y: 8.1, schX: 2.0, schY: 4.8 },\n+  { name: \"C6\", capacitance: \"1uF\", x: 4.8, y: 8.1, schX: 3.4, schY: 4.8 },\n+  { name: \"C7\", capacitance: \"10uF\", x: 7.2, y: 8.1, schX: 4.8, schY: 4.8 },\n+] as const\n+\n+const Flash = (props: any) => (\n+  <chip\n+    pinL