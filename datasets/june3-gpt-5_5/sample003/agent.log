[recv] {"method":"item/started","params":{"item":{"type":"fileChange","id":"call_FBvahNmLXjvTKlLOHQZ4lOol","changes":[{"path":"/workspace/index.circuit.tsx","kind":{"type":"add"},"diff":"import { RP2040 } from \"./imports/RP2040\"\n\nconst gpioLeft = [\n  \"GPIO0\",\n  \"GPIO1\",\n  \"GPIO2\",\n  \"GPIO3\",\n  \"GPIO4\",\n  \"GPIO5\",\n  \"GPIO6\",\n  \"GPIO7\",\n  \"GPIO8\",\n  \"GPIO9\",\n  \"GPIO10\",\n  \"GPIO11\",\n  \"GPIO12\",\n  \"GPIO13\",\n] as const\n\nconst gpioRight = [\n  \"GPIO14\",\n  \"GPIO15\",\n  \"GPIO16\",\n  \"GPIO17\",\n  \"GPIO18\",\n  \"GPIO19\",\n  \"GPIO20\",\n  \"GPIO21\",\n  \"GPIO22\",\n  \"GPIO26_ADC0\",\n  \"GPIO27_ADC1\",\n  \"GPIO28_ADC2\",\n  \"GPIO29_ADC3\",\n] as const\n\nconst leftHeaderLabels = [\"VBUS\", \"GND\", \"3V3\", ...gpioLeft] as const\nconst rightHeaderLabels = [\"RUN\", \"SWCLK\", \"SWD\", \"GND\", ...gpioRight] as const\n\nconst powerPins = [\n  \"IOVDD1\",\n  \"IOVDD2\",\n  \"IOVDD3\",\n  \"IOVDD4\",\n  \"IOVDD5\",\n  \"IOVDD6\",\n  \"USB_VDD\",\n  \"ADC_AVDD\",\n  \"VREG_IN\",\n] as const\n\nconst decouplers = [\n  { name: \"C1\", capacitance: \"100nF\", x: -7.2, y: 8.1 },\n  { name: \"C2\", capacitance: \"100nF\", x: -4.8, y: 8.1 },\n  { name: \"C3\", capacitance: \"100nF\", x: -2.4, y: 8.1 },\n  { name: \"C4\", capacitance: \"100nF\", x: 0, y: 8.1 },\n  { name: \"C5\", capacitance: \"100nF\", x: 2.4, y: 8.1 },\n  { name: \"C6\", capacitance: \"1uF\", x: 4.8, y: 8.1 },\n  { name: \"C7\", capacitance: \"10uF\", x: 7.2, y: 8.1 },\n] as const\n\nconst Flash = (props: any) => (\n  <chip\n    pinLabels={{\n      pin1: \"CS\",\n      pin2: \"IO1\",\n      pin3: \"IO2\",\n      pin4: \"GND\",\n      pin5: \"IO0\",\n      pin6: \"SCLK\",\n      pin7: \"IO3\",\n      pin8: \"VCC\",\n    }}\n    manufacturerPartNumber=\"W25Q16JVSSIQ\"\n    supplierPartNumbers={{ jlcpcb: [\"C82317\"] }}\n    footprint=\"soic8_p1.27mm\"\n    {...props}\n  />\n)\n\nconst Ldo = (props: any) => (\n  <chip\n    pinLabels={{\n      pin1: \"VIN\",\n      pin2: \"GND\",\n      pin3: \"EN\",\n      pin4: \"NC\",\n      pin5: \"VOUT\",\n    }}\n    manufacturerPartNumber=\"XC6220B331MR-G\"\n    supplierPartNumbers={{ jlcpcb: [\"C86533\"] }}\n    footprint=\"sot23_5\"\n    {...props}\n  />\n)\n\nexport default () => (\n  <board width=\"48mm\" height=\"28mm\" layers={2}>\n    <RP2040 name=\"U1\" pcbX={0} pcbY={0} schX={0} schY={0} />\n\n    <Flash name=\"U2\" pcbX={0} pcbY={-8.6} schX={7} schY={-2} />\n    <Ldo name=\"U3\" pcbX={-13.5} pcbY={8.6} schX={-8} schY={4} />\n\n    <connector\n      name=\"JUSB\"\n      standard=\"usb_c\"\n      pcbX={0}\n      pcbY={13.2}\n      pcbRotation={180}\n      schX={-8}\n      schY={8}\n    />\n\n    <pinheader\n      name=\"J1\"\n      pinCount={leftHeaderLabels.length}\n      pinLabels={[...leftHeaderLabels]}\n      gender=\"female\"\n      pitch=\"2.54mm\"\n      footprint={`pinrow${leftHeaderLabels.length}`}\n      pcbX={-21}\n      pcbY={0}\n      pcbRotation={90}\n      schX={-10}\n      schY={-3}\n      showSilkscreenPinLabels\n    />\n\n    <pinheader\n      name=\"J2\"\n      pinCount={rightHeaderLabels.length}\n      pinLabels={[...rightHeaderLabels]}\n      gender=\"female\"\n      pitch=\"2.54mm\"\n      footprint={`pinrow${rightHeaderLabels.length}`}\n      pcbX={21}\n      pcbY={0}\n      pcbRotation={90}\n      schX={10}\n      schY={-3}\n      showSilkscreenPinLabels\n    />\n\n    <crystal\n      name=\"Y1\"\n      frequency=\"12MHz\"\n      loadCapacitance=\"10pF\"\n      footprint=\"crystal3225\"\n      supplierPartNumbers={{ jlcpcb: [\"C9002\"] }}\n      pcbX={-8.8}\n      pcbY={-6.8}\n      schX={-7}\n      schY={-5}\n    />\n\n    <resistor name=\"R1\" resistance=\"27\" footprint=\"0402\" pcbX={-4.2} pcbY={7.1} schX={-3} schY={7} />\n    <resistor name=\"R2\" resistance=\"27\" footprint=\"0402\" pcbX={4.2} pcbY={7.1} schX={-3} schY={6} />\n    <resistor name=\"R3\" resistance=\"5.1k\" footprint=\"0402\" pcbX={-9.8} pcbY={11.4} schX={-7} schY={6} />\n    