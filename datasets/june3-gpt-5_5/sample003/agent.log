[recv] {"method":"item/commandExecution/outputDelta","params":{"threadId":"019e8ead-3fe9-7073-8d25-1b277e826e16","turnId":"019e8ead-3ff4-7252-8829-239cc99569de","itemId":"call_41F77E37ELW6hVTjQI1FzRm6","delta":"Usage: tsci build [options] [file]\n\nRun tscircuit eval and output circuit json\n\nArguments:\n  file                            Path to the entry file\n\nOptions:\n  --ci                            Run install and optional prebuild/build\n                                  commands (or default CI build)\n  --ignore-errors                 Do not exit with code 1 on errors\n  --ignore-warnings               Do not log warnings\n  --ignore-netlist-drc            Ignore netlist DRC errors/warnings\n  --ignore-pin-specification-drc  Ignore pin-specification DRC errors/warnings\n  --ignore-placement-drc          Ignore placement DRC errors/warnings\n  --ignore-routing-drc            Ignore routing DRC errors/warnings\n  --ignore-config                 Ignore options from tscircuit.config.json\n  --disable-pcb                   Disable PCB outputs\n  --routing-disabled              Disable routing during circuit generation\n  --disable-parts-engine          Disable the parts engine\n  --site                          Generate a static site in the dist directory\n  --transpile                     Transpile the entry file to JavaScript\n  --preview-images                Generate preview images in the dist directory\n  --all-images                    Generate preview images for every successful\n                                  build output\n  --pngs                          Generate PNG outputs during build generation\n  --pcb-png                       Generate PCB PNG outputs during build\n                                  generation\n  --svgs                          Generate SVG outputs during build generation\n  --pcb-svgs                      Generate PCB SVG outputs during build\n                                  generation\n  --schematic-svgs                Generate schematic SVG outputs during build\n                                  generation\n  --3d-png                        Generate 3D PNG outputs during build\n                                  generation\n  --3d                            Generate 3D PNG outputs during build\n                                  generation\n  --pcb-only                      Generate only PCB SVG outputs during build\n                                  generation\n  --schematic-only                Generate only schematic SVG outputs during\n                                  build generation\n  --kicad-project                 Generate KiCad project directories for each\n                                  successful build output\n  --kicad-project-zip             Generate a zipped KiCad project for each\n                                  successful build output\n  --kicad-library                 Generate KiCad library in dist/kicad-library\n  --kicad-library-name <name>     Specify the name of the KiCad library\n  --preview-gltf                  Generate a GLTF file from the preview\n                                  entrypoint\n  --show-courtyards               Show courtyard outlines in PCB SVG outputs\n  --glbs                          Generate GLB 3D model files for every\n                                  successful build\n  --step                          Generate STEP 3D model files for every\n                                  successful build\n  --profile                       Log per-circuit circuit.json generation time\n                                  during build\n  --kicad-pcm                     Generate KiCad PCM (Plugin and Content\n                                  Manager) assets in dist/pcm\n  --use-cdn-javascript            Use CDN-hosted JavaScript instead of bundled\n                                  standalone file for --site\n  --concurrency <number>          Number of files to build in parallel (default:\n                                  1) (default: \"1\")\n  --inject-props <json>           Inject JSON props into the built file's\n                                  default export\n  --inject-props-file <path>      Inject JSON props from a file into the built\n                                  file's default export\n  -h, --help                      display help for command\n"}}
