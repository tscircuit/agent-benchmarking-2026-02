fied object\n    --diff-filter [(A|C|D|M|R|T|U|X|B)...[*]]\n                          select files by diff type\n    --max-depth <depth>   maximum tree depth to recurse\n    --output <file>       output to a specific file\n\n","exitCode":129,"durationMs":0},"threadId":"019e8ebe-3350-7570-90f8-ccea92f86cdd","turnId":"019e8ebe-335b-7063-9c14-de69357ce45c","completedAtMs":1780512341574}}
