+      schSectionName=\"USB and Power\"\n+    />\n+\n+    <RP2040\n+      name=\"U1\"\n+      pcbX={3}\n+      pcbY={0}\n+      schX={0}\n+      schY={0}\n+      schSectionName=\"RP2040\"\n+      schPinArrangement={{\n+        leftSide: {\n+          direction: \"top-to-bottom\",\n+          pins: [\n+            \"USB_DP\",\n+            \"USB_DM\",\n+            \"XIN\",\n+            \"XOUT\",\n+            \"QSPI_SS\",\n+            \"QSPI_SCLK\",\n+            \"QSPI_SD0\",\n+            \"QSPI_SD1\",\n+            \"QSPI_SD2\",\n+            \"QSPI_SD3\",\n+          ],\n+        },\n+        rightSide: {\n+          direction: \"top-to-bottom\",\n+          pins: [\n+            \"GPIO0\",\n+            \"GPIO1\",\n+            \"GPIO2\",\n+            \"GPIO3\",\n+            \"GPIO4\",\n+            \"GPIO5\",\n+            \"GPIO6\",\n+            \"GPIO7\",\n+            \"GPIO8\",\n+            \"GPIO9\",\n+            \"GPIO10\",\n+            \"GPIO11\",\n+            \"GPIO12\",\n+            \"GPIO13\",\n+            \"GPIO14\",\n+            \"GPIO15\",\n+            \"GPIO16\",\n+            \"GPIO17\",\n+            \"GPIO18\",\n+            \"GPIO19\",\n+            \"GPIO25\",\n+          ],\n+        },\n+        topSide: {\n+          direction: \"left-to-right\",\n+          pins: [\n+            \"IOVDD1\",\n+            \"IOVDD2\",\n+            \"IOVDD3\",\n+            \"IOVDD4\",\n+            \"IOVDD5\",\n+            \"IOVDD6\",\n+            \"ADC_AVDD\",\n+            \"USB_VDD\",\n+            \"VREG_IN\",\n+          ],\n+        },\n+        bottomSide: {\n+          direction: \"left-to-right\",\n+          pins: [\"DVDD1\", \"DVDD2\", \"VREG_VOUT\", \"RUN\", \"SWCLK\", \"SWD\", \"TESTEN\", \"GND\"],\n+        },\n+      }}\n+    />\n+\n+    <W25Q16JVUXIQ\n+      name=\"U3\"\n+      pcbX={3}\n+      pcbY={8.7}\n+      schX={-5}\n+      schY={-3}\n+      schSectionName=\"QSPI Flash\"\n+    />\n+\n+    <crystal\n+      name=\"Y1\"\n+      frequency=\"12MHz\"\n+      loadCapacitance=\"18pF\"\n+      footprint=\"crystal3.2x2.5\"\n+      pcbX={3}\n+      pcbY={-8.2}\n+      schX={-5}\n+      schY={0}\n+      schSectionName=\"RP2040\"\n+    />\n+\n+    <pinheader\n+      name=\"J1\"\n+      pinCount={leftHeaderSignals.length}\n+      pitch=\"2.54mm\"\n+      gender=\"female\"\n+      footprint=\"pinrow14\"\n+      showSilkscreenPinLabels\n+      pinLabels={[...leftHeaderSignals]}\n+      pcbX={-19}\n+      pcbY={0}\n+      pcbRotation={90}\n+      schX={5.5}\n+      schY={1.5}\n+      schSectionName=\"Breakout Headers\"\n+    />\n+    <pinheader\n+      name=\"J2\"\n+      pinCount={rightHeaderSignals.length}\n+      pitch=\"2.54mm\"\n+      gender=\"female\"\n+      footprint=\"pinrow14\"\n+      showSilkscreenPinLabels\n+      pinLabels={[...rightHeaderSignals]}\n+      pcbX={21}\n+      pcbY={0}\n+      pcbRotation={90}\n+      schX={8}\n+      schY={1.5}\n+      schSectionName=\"Breakout Headers\"\n+    />\n+\n+    <led\n+      name=\"D1\"\n+      color=\"green\"\n+      footprint=\"0603\"\n+      pcbX={13}\n+      pcbY={-8}\n+      schX={4}\n+      schY={-3.5}\n+      schSectionName=\"Status LED\"\n+    />\n+    <resistor\n+      name=\"RLED\"\n+      resistance=\"1k\"\n+      footprint=\"0603\"\n+      pcbX={10.5}\n+      pcbY={-8}\n+      schX={2.7}\n+      schY={-3.5}\n+      schSectionName=\"Status LED\"\n+    />\n+\n+    <resistor name=\"RCC1\" resistance=\"5.1k\" footprint=\"0603\" pcbX={-13} pcbY={4.8} schSectionName=\"USB and Power\" />\n+    <resistor name=\"RCC2\" resistance=\"5.1k\" footprint=\"0603\" pcbX={-13} pcbY={2.8} schSectionName=\"USB and Power\" />\n+    <resistor name=\"RRUN\" resistance=\"10k\" footprint=\"0603\" pcbX={9} pcbY={-6} schSectionName=\"RP2040\" />\n+\n+    <capacitor name=\"CIN\" capacitance=\"1uF\" footprint=\"0603\" pcbX={-11.5} pcbY={-7.8} schSectionName=\"USB and Power\" />\n+    <capacitor name=\"COUT\" capacitance=\"1uF\" footprint=\"0603\" pcbX={-5.