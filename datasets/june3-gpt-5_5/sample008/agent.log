ins: [\n+            \"USB_DP\",\n+            \"USB_DM\",\n+            \"XIN\",\n+            \"XOUT\",\n+            \"QSPI_SS\",\n+            \"QSPI_SCLK\",\n+            \"QSPI_SD0\",\n+            \"QSPI_SD1\",\n+            \"QSPI_SD2\",\n+            \"QSPI_SD3\",\n+          ],\n+        },\n+        rightSide: {\n+          direction: \"top-to-bottom\",\n+          pins: [\n+            \"GPIO0\",\n+            \"GPIO1\",\n+            \"GPIO2\",\n+            \"GPIO3\",\n+            \"GPIO4\",\n+            \"GPIO5\",\n+            \"GPIO6\",\n+            \"GPIO7\",\n+            \"GPIO8\",\n+            \"GPIO9\",\n+            \"GPIO10\",\n+            \"GPIO11\",\n+            \"GPIO12\",\n+            \"GPIO13\",\n+            \"GPIO14\",\n+            \"GPIO15\",\n+            \"GPIO16\",\n+            \"GPIO17\",\n+            \"GPIO18\",\n+            \"GPIO19\",\n+            \"GPIO25\",\n+          ],\n+        },\n+        topSide: {\n+          direction: \"left-to-right\",\n+          pins: [\n+            \"IOVDD1\",\n+            \"IOVDD2\",\n+            \"IOVDD3\",\n+            \"IOVDD4\",\n+            \"IOVDD5\",\n+            \"IOVDD6\",\n+            \"ADC_AVDD\",\n+            \"USB_VDD\",\n+            \"VREG_IN\",\n+          ],\n+        },\n+        bottomSide: {\n+          direction: \"left-to-right\",\n+          pins: [\"DVDD1\", \"DVDD2\", \"VREG_VOUT\", \"RUN\", \"SWCLK\", \"SWD\", \"TESTEN\", \"GND\"],\n+        },\n+      }}\n+    />\n+\n+    <W25Q16JVUXIQ\n+      name=\"U3\"\n+      pcbX={3}\n+      pcbY={6.2}\n+      schX={-5}\n+      schY={-3}\n+      schHeight={1}\n+      schSectionName=\"QSPI Flash\"\n+    />\n+\n+    <crystal\n+      name=\"Y1\"\n+      frequency=\"12MHz\"\n+      loadCapacitance=\"18pF\"\n+      footprint=\"hc49\"\n+      pcbX={3}\n+      pcbY={-11}\n+      schX={-5}\n+      schY={0}\n+      schSectionName=\"RP2040\"\n+    />\n+\n+    <pinheader\n+      name=\"J1\"\n+      pinCount={leftHeaderSi