[recv] {"method":"item/started","params":{"item":{"type":"fileChange","id":"call_4G8Q2zDpnO2jcLIbpeDMH6Dg","changes":[{"path":"/workspace/index.circuit.tsx","kind":{"type":"add"},"diff":"import { AP2112K_3_3TRG1 } from \"./imports/AP2112K_3_3TRG1\"\nimport { RP2040 } from \"./imports/RP2040\"\nimport { TYPE_C_16PIN_2MD_073_ } from \"./imports/TYPE_C_16PIN_2MD_073_\"\nimport { W25Q16JVUXIQ } from \"./imports/W25Q16JVUXIQ\"\n\nconst rpPowerPins = [\n  \"IOVDD1\",\n  \"IOVDD2\",\n  \"IOVDD3\",\n  \"IOVDD4\",\n  \"IOVDD5\",\n  \"IOVDD6\",\n  \"ADC_AVDD\",\n  \"USB_VDD\",\n] as const\n\nconst rpCorePins = [\"DVDD1\", \"DVDD2\", \"VREG_VOUT\"] as const\n\nconst leftHeaderSignals = [\n  \"V3_3\",\n  \"GND\",\n  \"GPIO0\",\n  \"GPIO1\",\n  \"GPIO2\",\n  \"GPIO3\",\n  \"GPIO4\",\n  \"GPIO5\",\n  \"GPIO6\",\n  \"GPIO7\",\n  \"GPIO8\",\n  \"GPIO9\",\n  \"SWCLK\",\n  \"SWD\",\n] as const\n\nconst rightHeaderSignals = [\n  \"VBUS\",\n  \"GND\",\n  \"GPIO10\",\n  \"GPIO11\",\n  \"GPIO12\",\n  \"GPIO13\",\n  \"GPIO14\",\n  \"GPIO15\",\n  \"GPIO16\",\n  \"GPIO17\",\n  \"GPIO18\",\n  \"GPIO19\",\n  \"RUN\",\n  \"BOOTSEL\",\n] as const\n\nexport default () => (\n  <board width=\"48mm\" height=\"28mm\" layers={2}>\n    <TYPE_C_16PIN_2MD_073_\n      name=\"JUSB\"\n      pcbX={-17}\n      pcbY={0}\n      pcbRotation={-90}\n      schX={-7}\n      schY={4}\n      schSectionName=\"USB and Power\"\n    />\n\n    <AP2112K_3_3TRG1\n      name=\"U2\"\n      pcbX={-8.5}\n      pcbY={-6}\n      pcbRotation={180}\n      schX={-2}\n      schY={4}\n      schSectionName=\"USB and Power\"\n    />\n\n    <RP2040\n      name=\"U1\"\n      pcbX={3}\n      pcbY={0}\n      schX={0}\n      schY={0}\n      schSectionName=\"RP2040\"\n      schPinArrangement={{\n        leftSide: {\n          direction: \"top-to-bottom\",\n          pins: [\n            \"USB_DP\",\n            \"USB_DM\",\n            \"XIN\",\n            \"XOUT\",\n            \"QSPI_SS\",\n            \"QSPI_SCLK\",\n            \"QSPI_SD0\",\n            \"QSPI_SD1\",\n            \"QSPI_SD2\",\n            \"QSPI_SD3\",\n          ],\n        },\n        rightSide: {\n          direction: \"top-to-bottom\",\n          pins: [\n            \"GPIO0\",\n            \"GPIO1\",\n            \"GPIO2\",\n            \"GPIO3\",\n            \"GPIO4\",\n            \"GPIO5\",\n            \"GPIO6\",\n            \"GPIO7\",\n            \"GPIO8\",\n            \"GPIO9\",\n            \"GPIO10\",\n            \"GPIO11\",\n            \"GPIO12\",\n            \"GPIO13\",\n            \"GPIO14\",\n            \"GPIO15\",\n            \"GPIO16\",\n            \"GPIO17\",\n            \"GPIO18\",\n            \"GPIO19\",\n            \"GPIO25\",\n          ],\n        },\n        topSide: {\n          direction: \"left-to-right\",\n          pins: [\n            \"IOVDD1\",\n            \"IOVDD2\",\n            \"IOVDD3\",\n            \"IOVDD4\",\n            \"IOVDD5\",\n            \"IOVDD6\",\n            \"ADC_AVDD\",\n            \"USB_VDD\",\n            \"VREG_IN\",\n          ],\n        },\n        bottomSide: {\n          direction: \"left-to-right\",\n          pins: [\"DVDD1\", \"DVDD2\", \"VREG_VOUT\", \"RUN\", \"SWCLK\", \"SWD\", \"TESTEN\", \"GND\"],\n        },\n      }}\n    />\n\n    <W25Q16JVUXIQ\n      name=\"U3\"\n      pcbX={3}\n      pcbY={8.7}\n      schX={-5}\n      schY={-3}\n      schSectionName=\"QSPI Flash\"\n    />\n\n    <crystal\n      name=\"Y1\"\n      frequency=\"12MHz\"\n      loadCapacitance=\"18pF\"\n      footprint=\"crystal3.2x2.5\"\n      pcbX={3}\n      pcbY={-8.2}\n      schX={-5}\n      schY={0}\n      schSectionName=\"RP2040\"\n    />\n\n    <pinheader\n      name=\"J1\"\n      pinCount={leftHeaderSignals.length}\n      pitch=\"2.54mm\"\n      gender=\"female\"\n      footprint=\"pinrow14\"\n      showSilkscreenPinLabels\n      pinLabels={[...leftHeaderSignals]}\n      pcbX={-19}\n      pcbY={0}\n      pcbRotation={90}\n      schX={5.5}\n      schY={1.5}\n      schSectionName=\"Breakout Headers\"\n    />\n    <pinheader\n      name=\"J2\"\n      pinCount={rightHeaderSignals.length}\n      pitch=\"2.54mm\"\n      gender=\"female\"\n      footprint=\"pinrow14\"\n      showSilkscreenPinLabels\n      pinLabels={[...rightHeaderSignals]}\n      pcbX={21}\n      pcbY={0}\n      pcbRotation={90}\n      schX={8}\n      schY={1.5}\n      schSectionName=\"Breakout Headers\"\n    />\n\n    <led\n      name=\"D1\"\n      color=\"green\"\n      footprint=\"0603\"\n      pcbX={13}\n      pcbY={-8}\n      schX={4}\n      schY={-3.5}\n      schSectionName=\"Status LED\"\n    />\n    <resistor\n      name=\"RLED\"\n      resistance=\"1k\"\n      footprint=\"0603\"\n      pcbX={10.5}\n      pcbY={-8}\n      schX={2.7}\n      schY={-3.5}\n      schSectionName=\"Status LED\"\n    />\n\n    <resistor name=\"RCC1\" resistance=\"5.1k\" footprint=\"0603\" pcbX={-13} pcbY={4.8} schSectionName=\"USB and Power\" />\n    <resistor name=\"RCC2\" resistance=\"5.1k\" footprint=\"0603\" pcbX={-13} pcbY={2.8} schSectionName=\"USB and Power\" />\n    <resistor name=\"RRUN\" resistance=\"10k\" footprint=\"0603\" pcbX={9} pcbY={-6} schSectionName=\"RP2040\" />\n\n    <capacitor name=\"CIN\" capacitance=\"1uF\" footprint=\"0603\" pcbX={-11.5} pcbY={-7.8} schSectionName=\"USB and Power\" />\n    <capacitor name=\"COUT\" capacitance=\"1uF\" footprint=\"0603\" pcbX={-5.3} pcbY={-7.8} schSectionName=\"USB and Power\" />\n    <capacitor name=\"CUSB\" capacitance=\"1uF\" footprint=\"0603\" pcbX={-1.5} pcbY={4.8} schSectionName=\"RP2040\" />\n    <capacitor name=\"CVREG\" capacitance=\"1uF\" footprint=\"0603\" pcbX={7.8} pcbY={3.5} schSectionName=\"RP2040\" />\n    <capacitor name=\"CFLASH\" capacitance=\"100nF\" footprint=\"0603\" pcbX={6.7} pcbY={8.7} schSectionName=\"QSPI Flash\" />\n    <capacitor name=\"CX1\" capacitance=\"18pF\" footprint=\"0603\" pcbX={-0.4} pcbY={-10.2} schSectionName=\"RP2040\" />\n    <capacitor name=\"CX2\" capacitance=\"18pF\" footprint=\"0603\" pcbX={6.5} pcbY={-10.2} schSectionName=\"RP2040\" />\n\n    <solderjumper\n      name=\"BOOTSEL\"\n      footprint=\"solderjumper2_bridged123\"\n      pcbX={9}\n      pcbY={8.5}\n      schSectionName=\"QSPI Flash\"\n    />\n\n    <silkscreentext text=\"RP2040 USB BREAKOUT\" pcbX={1.5} pcbY={12.2} fontSize=\"1mm\" anchorAlignment=\"center\" />\n    <silkscreentext text=\"LED GP25\" pcbX={13} pcbY={-10.5} fontSize=\"0.8mm\" anchorAlignment=\"center\" />\n\n    <trace from=\".JUSB > .A4B9\" to=\"net.VBUS\" />\n    <trace from=\".JUSB > .B4A9\" to=\"net.VBUS\" />\n    <trace from=\".JUSB > .A1B12\" to=\"net.GND\" />\n    <trace from=\".JUSB > .B1A12\" to=\"net.GND\" />\n    <trace from=\".JUSB > .EH1\" to=\"net.GND\" />\n    <trace from=\".JUSB > .EH2\" to=\"net.GND\" />\n    <trace from=\".JUSB > .A6\" to=\".U1 > .USB_DP\" thickness=\"0.18mm\" />\n    <trace from=\".JUSB > .B6\" to=\".U1 > .USB_DP\" thickness=\"0.18mm\" />\n    <trace from=\".JUSB > .A7\" to=\".U1 > .USB_DM\" thickness=\"0.18mm\" />\n    <trace from=\".JUSB > .B7\" to=\".U1 > .USB_DM\" thickness=\"0.18mm\" />\n    <trace from=\".JUSB > .A5\" to=\".RCC1 > .pin1\" />\n    <trace from=\".RCC1 > .pin2\" to=\"net.GND\" />\n    <trace from=\".JUSB > .B5\" to=\".RCC2 > .pin1\" />\n    <trace from=\".RCC2 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\"net.VBUS\" to=\".U2 > .VIN\" thickness=\"0.3mm\" />\n    <trace from=\"net.VBUS\" to=\".U2 > .EN\" />\n    <trace from=\".U2 > .GND\" to=\"net.GND\" />\n    <trace from=\".U2 > .VOUT\" to=\"net.V3_3\" thickness=\"0.3mm\" />\n    <trace from=\".CIN > .pin1\" to=\"net.VBUS\" />\n    <trace from=\".CIN > .pin2\" to=\"net.GND\" />\n    <trace from=\".COUT > .pin1\" to=\"net.V3_3\" />\n    <trace from=\".COUT > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .VREG_IN\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .TESTEN\" to=\"net.GND\" />\n    <trace from=\".U1 > .GND\" to=\"net.GND\" />\n    {rpPowerPins.map((pin) => (\n      <trace key={`pwr-${pin}`} from={`.U1 > .${pin}`} to=\"net.V3_3\" />\n    ))}\n    {rpCorePins.map((pin) => (\n      <trace key={`core-${pin}`} from={`.U1 > .${pin}`} to=\"net.VREG_CORE\" />\n    ))}\n    <trace from=\".CUSB > .pin1\" to=\".U1 > .USB_VDD\" />\n    <trace from=\".CUSB > .pin2\" to=\"net.GND\" />\n    <trace from=\".CVREG > .pin1\" to=\"net.VREG_CORE\" />\n    <trace from=\".CVREG > .pin2\" to=\"net.GND\" />\n    <trace from=\".RRUN > .pin1\" to=\"net.V3_3\" />\n    <trace from=\".RRUN > .pin2\" to=\".U1 > .RUN\" />\n\n    <trace from=\".Y1 > .pin1\" to=\".U1 > .XIN\" />\n    <trace from=\".Y1 > .pin2\" to=\".U1 > .XOUT\" />\n    <trace from=\".CX1 > .pin1\" to=\".U1 > .XIN\" />\n    <trace from=\".CX1 > .pin2\" to=\"net.GND\" />\n    <trace from=\".CX2 > .pin1\" to=\".U1 > .XOUT\" />\n    <trace from=\".CX2 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U3 > .VCC\" to=\"net.V3_3\" />\n    <trace from=\".U3 > .GND\" to=\"net.GND\" />\n    <trace from=\".U3 > .EP\" to=\"net.GND\" />\n    <trace from=\".CFLASH > .pin1\" to=\".U3 > .VCC\" />\n    <trace from=\".CFLASH > .pin2\" to=\"net.GND\" />\n    <trace from=\".U3 > .CS\" to=\".U1 > .QSPI_SS\" />\n    <trace from=\".U3 > .CLK\" to=\".U1 > .QSPI_SCLK\" />\n    <trace from=\".U3 > .pin5\" to=\".U1 > .QSPI_SD0\" />\n    <trace from=\".U3 > .pin2\" to=\".U1 > .QSPI_SD1\" />\n    <trace from=\".U3 > .pin3\" to=\".U1 > .QSPI_SD2\" />\n    <trace from=\".U3 > .pin7\" to=\".U1 > .QSPI_SD3\" />\n    <trace from=\".BOOTSEL > .pin1\" to=\".U3 > .CS\" />\n    <trace from=\".BOOTSEL > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .GPIO25\" to=\".RLED > .pin1\" />\n    <trace from=\".RLED > .pin2\" to=\".D1 > .pin1\" />\n    <trace from=\".D1 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".J1 > .pin1\" to=\"net.V3_3\" />\n    <trace from=\".J1 > .pin2\" to=\"net.GND\" />\n    {leftHeaderSignals.slice(2, 12).map((pin, idx) => (\n      <trace key={`j1-${pin}`} from={`.J1 > .pin${idx + 3}`} to={`.U1 > .${pin}`} />\n    ))}\n    <trace from=\".J1 > .pin13\" to=\".U1 > .SWCLK\" />\n    <trace from=\".J1 > .pin14\" to=\".U1 > .SWD\" />\n\n    <trace from=\".J2 > .pin1\" to=\"net.VBUS\" />\n    <trace from=\".J2 > .pin2\" to=\"net.GND\" />\n    {rightHeaderSignals.slice(2, 12).map((pin, idx) => (\n      <trace key={`j2-${pin}`} from={`.J2 > .pin${idx + 3}`} to={`.U1 > .${pin}`} />\n    ))}\n    <trace from=\".J2 > .pin13\" to=\".U1 > .RUN\" />\n    <trace from=\".J2 > .pin14\" to=\".U3 > .CS\" />\n  </board>\n)\n"}],"status":"inProgress"},"threadId":"019e8ebe-3350-7570-90f8-ccea92f86cdd","turnId":"019e8ebe-335b-7063-9c14-de69357ce45c","startedAtMs":1780511483588}}
