inLabels\n      pinLabels={[...gpioRight, \"SWD\", \"SWCLK\"]}\n      pcbX={17.5}\n      pcbY={0}\n      schX={7.5}\n      schY={-2.5}\n    />\n\n    <resistor name=\"R1\" resistance=\"330ohm\" footprint=\"0603\" pcbX={8} pcbY={9} schX={7.5} schY={3} />\n    <led name=\"D1\" color=\"green\" footprint=\"0603\" pcbX={11} pcbY={9} schX={9.5} schY={3} />\n\n    <resistor name=\"R2\" resistance=\"5.1kohm\" footprint=\"0603\" pcbX={-16} pcbY={5} schX={-7} schY={1} />\n    <resistor name=\"R3\" resistance=\"5.1kohm\" footprint=\"0603\" pcbX={-16} pcbY={-5} schX={-7} schY={-1} />\n    <resistor name=\"R4\" resistance=\"1kohm\" footprint=\"0603\" pcbX={-4} pcbY={-9} schX={1.5} schY={-3.5} />\n\n    <capacitor name=\"C1\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-10} pcbY={8.5} schX={-4.5} schY={4.5} />\n    <capacitor name=\"C2\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-9} pcbY={3} schX={-2} schY={4.5} />\n    <capacitor name=\"C3\" capacitance=\"100nF\" footprint=\"0402\" pcbX={-3.5} pcbY={4.5} schX={0.5} schY={3} />\n    <capacitor name=\"C4\" capacitance=\"100nF\" footprint=\"0402\" pcbX={3.5} pcbY={4.5} schX={1.5} schY={3} />\n    <capacitor name=\"C5\" capacitance=\"100nF\" footprint=\"0402\" pcbX={4.5} pcbY={0} schX={2.5} schY={3} />\n    <capacitor name=\"C6\" capacitance=\"1uF\" footprint=\"0402\" pcbX={-3.5} pcbY={-4.5} schX={3.5} schY={3} />\n    <capacitor name=\"C7\" capacitance=\"12pF\" footprint=\"0402\" pcbX={-3.8} pcbY={-7} schX={5.5} schY={-3.5} />\n    <capacitor name=\"C8\" capacitance=\"12pF\" footprint=\"0402\" pcbX={3.8} pcbY={-7} schX={6.5} schY={-3.5} />\n\n    <testpoint name=\"TP1\" footprint=\"testpoint\" pcbX={13} pcbY={-9} schX={8} schY={-4} />\n    <testpoint name=\"TP2\" footprint=\"testpoint\" pcbX={16} pcbY={-9} schX={9} schY={-4} />\n\n    <silkscreentext text=\"RP2040 USB BREAKOUT\" pcbX={0} pcbY={13.2} fontSize={1} />\n    <silkscreentext text=\"BOOT\" pcbX={-6.5} pcbY={-11.5} fontSize={0.8} />\n\n    <trace from=\"USBC.VBUS1\" to=\"net.VBUS\" />\n    <trace from=\"USBC.VBUS2\" to=\"net.VBUS\" />\n    <trace from=\"USBC.GND1\" to=\"net.GND\" />\n    <trace from=\"USBC.GND2\" to=\"net.GND\" />\n    <trace from=\"USBC.DP1\" to=\"net.USB_DP\" />\n    <trace from=\"USBC.DP2\" to=\"net.USB_DP\" />\n    <trace from=\"USBC.DM1\" to=\"net.USB_DM\" />\n    <trace from=\"USBC.DM2\" to=\"net.USB_DM\" />\n    <trace from=\"USBC.CC1\" to=\"R2.pin1\" />\n    <trace from=\"USBC.CC2\" to=\"R3.pin1\" />\n    <trace from=\"R2.pin2\" to=\"net.GND\" />\n    <trace from=\"R3.pin2\" to=\"net.GND\" />\n\n    <trace from=\"U2.VIN\" to=\"net.VBUS\" />\n    <trace from=\"U2.CE\" to=\"net.VBUS\" />\n    <trace from=\"U2.VSS\" to=\"net.GND\" />\n    <trace from=\"U2.VOUT\" to=\"net.V3_3\" />\n    <trace from=\"C1.pin1\" to=\"net.VBUS\" />\n    <trace from=\"C1.pin2\" to=\"net.GND\" />\n    <trace from=\"C2.pin1\" to=\"net.V3_3\" />\n    <trace from=\"C2.pin2\" to=\"net.GND\" />\n\n    <trace from=\"U1.VREG_IN\" to=\"net.V3_3\" />\n    <trace from=\"U1.USB_VDD\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD1\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD2\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD3\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD4\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD5\" to=\"net.V3_3\" />\n    <trace from=\"U1.IOVDD6\" to=\"net.V3_3\" />\n    <trace from=\"U1.ADC_AVDD\" to=\"net.V3_3\" />\n    <trace from=\"U1.VREG_VOUT\" to=\"net.DVDD\" />\n    <trace from=\"U1.DVDD1\" to=\"net.DVDD\" />\n    <trace from=\"U1.DVDD2\" to=\"net.DVDD\" />\n    <trace from=\"U1.GND\" to=\"net.GND\" />\n    <trace from=\"C3.pin1\" to=\"net.V3_3\" />\n    <trace from=\"C3.pin2\" to=\"net.GND\" />\n    <trace from=\"C4.pin1\" to=\"net.V3_3\" />\n    <trace from=\"C4.pin2\" to=\"net.GND\" />\n    <trace from=\"C5.pin1\" to=\"net.V3_3\" />\n    <trace from=\"C5.pin2\" to=\"net.GND\" />\n    <trace from=\"C6.pin1\" to=\"net.DVDD\" />\n    <trace from=\"C6.pin2\" to=\"net.GND\" />\n\n    <trace from=\"U1.USB_DP\" to=\"net.USB_DP\" width=\"0.18mm\" />\n    <trace from=\"U1.USB_DM\" to=\"net.USB_DM\" width=\"0.18mm\" />\n    <trace from=\"U1.XIN\" to=\"Y1.pin1\" />\n    <trace from=\"U1.XOUT\" to=\"Y1.pin2\" />\n    <trace from=\"Y1.pin1\" to=\"C7.pin1\" />\n    <trace from=\"Y1.pin2\" to=\"C8.pin1\" />\n    <trace from=\"C7.pin2\" to=\"net.GND\" />\n    <trace from=\"C8.pin2\" to=\"net.GND\" />\n\n    <trace from=\"U3.VCC\" to=\"net.V3_3\" />\n    <trace from=\"U3.GND\" to=\"net.GND\" />\n    <trace from=\"U3.pin1\" to=\"U1.QSPI_SS\" />\n    <trace from=\"U3.pin2\" to=\"U1.QSPI_SD1\" />\n    <trace from=\"U3.IO2\" to=\"U1.QSPI_SD2\" />\n    <trace from=\"U3.pin5\" to=\"U1.QSPI_SD0\" />\n    <trace from=\"U3.CLK\" to=\"U1.QSPI_SCLK\" />\n    <trace from=\"U3.IO3\" to=\"U1.QSPI_SD3\" />\n\n    <trace from=\"U1.GPIO25\" to=\"R1.pin1\" />\n    <trace from=\"R1.pin2\" to=\"D1.pos\" />\n    <trace from=\"D1.neg\" to=\"net.GND\" />\n    <trace from=\"U1.QSPI_SS\" to=\"R4.pin1\" />\n    <trace from=\"R4.pin2\" to=\"TP1.pin1\" />\n    <trace from=\"TP1.pin1\" to=\"net.GND\" />\n    <trace from=\"U1.RUN\" to=\"TP2.pin1\" />\n\n    <trace from=\"J1.pin11\" to=\"net.V3_3\" />\n    <trace from=\"J1.pin12\" to=\"net.GND\" />\n    <trace from=\"J2.pin11\" to=\"U1.SWD\" />\n    <trace from=\"J2.pin12\" to=\"U1.SWCLK\" />\n\n    {gpioLeft.map((gpio, index) => (\n      <trace key={`left-${gpio}`} from={`U1.${gpio}`} to={`J1.pin${index + 1}`} />\n    ))}\n    {gpioRight.map((gpio, index) => (\n      <trace key={`right-${gpio}`} from={`U1.${gpio}`} to={`J2.pin${index + 1}`} />\n    ))}\n  </board>\n)\n"}],"status":"inProgress"},"threadId":"019e8ecc-76ea-7a23-a38a-5e7d3a9e9ac2","turnId":"019e8ecc-7701-7a81-a475-1d589a425a6e","startedAtMs":1780512425344}}
