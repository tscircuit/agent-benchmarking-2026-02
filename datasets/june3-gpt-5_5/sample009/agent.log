\"0402\" pcbX={4} pcbY={-8.5} schSectionName=\"USB\" schX={-7} schY={3} />\n+\n+    <capacitor name=\"C_IN\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-13.5} pcbY={-9.5} schSectionName=\"Power\" schX={-6} schY={1.5} />\n+    <capacitor name=\"C_OUT\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-13.5} pcbY={-6.5} schSectionName=\"Power\" schX={-6} schY={0.5} />\n+    <capacitor name=\"C_IO\" capacitance=\"1uF\" footprint=\"0402\" pcbX={5.5} pcbY={3.7} schSectionName=\"Power\" schX={-3} schY={1} />\n+    <capacitor name=\"C_CORE\" capacitance=\"1uF\" footprint=\"0402\" pcbX={4.4} pcbY={4.9} schSectionName=\"Power\" schX={-3} schY={0} />\n+    <capacitor name=\"C_USB\" capacitance=\"1uF\" footprint=\"0402\" pcbX={3.1} pcbY={4.9} schSectionName=\"Power\" schX={-3} schY={-1} />\n+    <capacitor name=\"C_XIN\" capacitance=\"18pF\" footprint=\"0402\" pcbX={-10.8} pcbY={-2.8} schSectionName=\"Flash and Clock\" schX={9} schY={-2} />\n+    <capacitor name=\"C_XOUT\" capacitance=\"18pF\" footprint=\"0402\" pcbX={-10.8} pcbY={-1.2} schSectionName=\"Flash and Clock\" schX={9} schY={-3} />\n+\n+    <resistor name=\"R_RUN\" resistance=\"10k\" footprint=\"0402\" pcbX={5.8} pcbY={-2.8} schSectionName=\"RP2040\" schX={3} schY={-2} />\n+    <pushbutton name=\"SW_RESET\" footprint=\"pushbutton\" pcbX={10.5} pcbY={-4.5} schSectionName=\"RP2040\" schX={5} schY={-2} />\n+    <resistor name=\"R_BOOT\" resistance=\"10k\" footprint=\"0402\" pcbX={-4.5} pcbY={7.8} schSectionName=\"Flash and Clock\" schX={5} schY={5} />\n+    <pushbutton name=\"SW_BOOT\" footprint=\"pushbutton\" pcbX={-10.5} pcbY={8.2} schSectionName=\"Flash and Clock\" schX={7} schY={5} />\n+\n+    <resistor name=\"R_LED\" resistance=\"1k\" footprint=\"0402\" pcbX={10.5} pcbY={5.5} schSectionName=\"RP2040\" schX={3} schY={2} />\n+    <led name=\"D_LED\" footprint=\"0603\" color=\"green\" pcbX={14} pcbY={5.5} schSectionName=\"RP2040\" schX={5} schY={2} />\n+\n+    <silkscreentext text=\"RP2040 USB BREAKOUT\" pcbX={0} pcbY={13.2} fontSize={1.3} anchorAlignment=\"center\" />\n+    <silkscreentext text=\"BOOT\" pcbX={-10.5} pcbY={11} fontSize={0.8} anchorAlignment=\"center\" />\n+    <silkscreentext text=\"RESET\" pcbX={10.5} pcbY={-7.5} fontSize={0.8} anchorAlignment=\"center\" />\n+    <silkscreentext text=\"GPIO25 LED\" pcbX={13.5} pcbY={7.6} fontSize={0.8} anchorAlignment=\"center\" />\n+\n+    <trace from=\".J_USB > .A4B9\" to=\"net.VBUS\" />\n+    <trace from=\".J_USB > .B4A9\" to=\"net.VBUS\" />\n+    <trace from=\".J_USB > .A1B12\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .B1A12\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .EH1\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .EH2\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .A5\" to=\".R_CC1 > .pin1\" />\n+    <trace from=\".R_CC1 > .pin2\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .B5\" to=\".R_CC2 > .pin1\" />\n+    <trace from=\".R_CC2 > .pin2\" to=\"net.GND\" />\n+    <trace from=\".J_USB > .A6\" to=\".R_USB_DP > .pin1\" />\n+    <trace from=\".J_USB > .B6\" to=\".R_USB_DP > .pin1\" />\n+    <trace from=\".R_USB_DP > .pin2\" to=\".U_MCU > .USB_DP\" />\n+    <trace from=\".J_USB > .A7\" to=\".R_USB_DM > .pin1\" />\n+    <trace from=\".J_USB > .B7\" to=\".R_USB_DM > .pin1\" />\n+    <trace from=\".R_USB_DM > .pin2\" to=\".U_MCU > .USB_DM\" />\n+\n+    <trace from=\".U_REG > .VIN\" to=\"net.VBUS\" />\n+    <trace from=\".U_REG > .CE\" to=\"net.VBUS\" />\n+    <trace from=\".U_REG > .VSS\" to=\"net.GND\" />\n+    <trace from=\".U_REG > .VOUT\" to=\"net.3V3\" />\n+    <trace from=\".C_IN > .pin1\" to=\"net.VBUS\" />\n+    <trace from=\".C_IN > .pin2\" to=\"net.GND\" />\n+    <trace from=\".C_OUT > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".C_OUT > .pin2\" to=\"net.GND\" />\n+\n+    {iovddPins.map((pin) => (\n+      <trace key={`iovdd-${pin}`} from={`.U_MCU > .${pin}`} to=\"net.3V3\" />\n+    ))}\n+    <trace from=\".U_MCU > .ADC_AVDD\" to=\"net.3V3\" />\n+    <trace from=\".U_MCU > .USB_VDD\" to=\"net.3V3\" />\n+    <trace from=\".U_MCU > .VREG_IN\" to=\"net.3V3\" />\n+    <trace from=\".U_MCU > .VREG_VOUT\" to=\"net.1V1\" />\n+    <trace from=\".U_MCU > .DVDD1\" to=\"net.1V1\" />\n+    <trace from=\".U_MCU > .DVDD2\" to=\"net.1V1\" />\n+    <trace from=\".U_MCU > .GND\" to=\"net.GND\" />\n+    <trace from=\".U_MCU > .TESTEN\" to=\"net.GND\" />\n+    <trace from=\".C_IO > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".C_IO > .pin2\" to=\"net.GND\" />\n+    <trace from=\".C_CORE > .pin1\" to=\"net.1V1\" />\n+    <trace from=\".C_CORE > .pin2\" to=\"net.GND\" />\n+    <trace from=\".C_USB > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".C_USB > .pin2\" to=\"net.GND\" />\n+\n+    <trace from=\".U_FLASH > .CS\" to=\".U_MCU > .QSPI_SS\" />\n+    <trace from=\".U_FLASH > .pin5\" to=\".U_MCU > .QSPI_SD0\" />\n+    <trace from=\".U_FLASH > .pin2\" to=\".U_MCU > .QSPI_SD1\" />\n+    <trace from=\".U_FLASH > .pin3\" to=\".U_MCU > .QSPI_SD2\" />\n+    <trace from=\".U_FLASH > .pin7\" to=\".U_MCU > .QSPI_SD3\" />\n+    <trace from=\".U_FLASH > .CLK\" to=\".U_MCU > .QSPI_SCLK\" />\n+    <trace from=\".U_FLASH > .VCC\" to=\"net.3V3\" />\n+    <trace from=\".U_FLASH > .GND\" to=\"net.GND\" />\n+    <trace from=\".U_FLASH > .EP\" to=\"net.GND\" />\n+\n+    <trace from=\".Y1 > .OSC1\" to=\".U_MCU > .XIN\" />\n+    <trace from=\".Y1 > .OSC2\" to=\".U_MCU > .XOUT\" />\n+    <trace from=\".Y1 > .GND1\" to=\"net.GND\" />\n+    <trace from=\".Y1 > .GND2\" to=\"net.GND\" />\n+    <trace from=\".C_XIN > .pin1\" to=\".U_MCU > .XIN\" />\n+    <trace from=\".C_XIN > .pin2\" to=\"net.GND\" />\n+    <trace from=\".C_XOUT > .pin1\" to=\".U_MCU > .XOUT\" />\n+    <trace from=\".C_XOUT > .pin2\" to=\"net.GND\" />\n+\n+    <trace from=\".R_RUN > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".R_RUN > .pin2\" to=\".U_MCU > .RUN\" />\n+    <trace from=\".SW_RESET > .pin1\" to=\".U_MCU > .RUN\" />\n+    <trace from=\".SW_RESET > .pin2\" to=\"net.GND\" />\n+    <trace from=\".R_BOOT > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".R_BOOT > .pin2\" to=\".U_MCU > .QSPI_SS\" />\n+    <trace from=\".SW_BOOT > .pin1\" to=\".U_MCU > .QSPI_SS\" />\n+    <trace from=\".SW_BOOT > .pin2\" to=\"net.GND\" />\n+\n+    <trace from=\".R_LED > .pin1\" to=\".U_MCU > .GPIO25\" />\n+    <trace from=\".R_LED > .pin2\" to=\".D_LED > .pin1\" />\n+    <trace from=\".D_LED > .pin2\" to=\"net.GND\" />\n+\n+    <trace from=\".J_LEFT > .pin1\" to=\"net.3V3\" />\n+    <trace from=\".J_LEFT > .pin2\" to=\"net.GND\" />\n+    {ioLeft.map((gpio, index) => (\n+      <trace key={`left-${gpio}`} from={`.J_LEFT > .pin${index + 3}`} to={`.U_MCU > .${gpio}`} />\n+    ))}\n+\n+    <trace from=\".J_RIGHT > .pin1\" to=\"net.VBUS\" />\n+    <trace from=\".J_RIGHT > .pin2\" to=\"net.GND\" />\n+    <trace from=\".J_RIGHT > .pin3\" to=\".U_MCU > .SWCLK\" />\n+    <trace from=\".J_RIGHT > .pin4\" to=\".U_MCU > .SWD\" />\n+    {ioRight.map((gpio, index) => (\n+      <trace key={`right-${gpio}`} from={`.J_RIGHT > .pin${index + 5}`} to={`.U_MCU > .${gpio}`} />\n+    ))}\n   </board>\n )\n"}}
