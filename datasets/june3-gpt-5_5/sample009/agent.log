int=\"0402\" pcbX={8.2} pcbY={-24} schSectionName=\"USB\" schX={-7} schY={3} />\n+\n+    <capacitor name=\"C_IN\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-16.5} pcbY={-18.8} schSectionName=\"Power\" schX={-6} schY={1.5} />\n+    <capacitor name=\"C_OUT\" capacitance=\"10uF\" footprint=\"0603\" pcbX={-16.5} pcbY={-15.2} schSectionName=\"Power\" schX={-6} schY={0.5} />\n+    <capacitor name=\"C_IO\" capacitance=\"1uF\" footprint=\"0402\" pcbX={5.9} pcbY={4.8} schSectionName=\"Power\" schX={-3} schY={1} />\n+    <capacitor name=\"C_CORE\" capacitance=\"1uF\" footprint=\"0402\" pcbX={7.8} pcbY={4.8} schSectionName=\"Power\" schX={-3} schY={0} />\n+    <capacitor name=\"C_USB\" capacitance=\"1uF\" footprint=\"0402\" pcbX={9.7} pcbY={4.8} schSectionName=\"Power\" schX={-3} schY={-1} />\n+    <capacitor name=\"C_XIN\" capacitance=\"18pF\" footprint=\"0402\" pcbX={-12.8} pcbY={-6.2} schSectionName=\"Flash and Clock\" schX={10} schY={-2} />\n+    <capacitor name=\"C_XOUT\" capacitance=\"18pF\" footprint=\"0402\" pcbX={-12.8} pcbY={-3.8} schSectionName=\"Flash and Clock\" schX={10} schY={-3.2} />\n+\n+    <resistor name=\"R_RUN\" resistance=\"10k\" footprint=\"0402\" pcbX={5.9} pcbY={-4.6} schSectionName=\"RP2040\" schX={3} schY={-2} />\n+    <pushbutton name=\"SW_RESET\" footprint=\"pushbutton\" pcbX={13.5} pcbY={-7.5} schSectionName=\"RP2040\" schX={5} schY={-2} />\n+    <resistor name=\"R_BOOT\" resistance=\"10k\" footprint=\"0402\" pcbX={-4.8} pcbY={11.5} schSectionName=\"Flash and Clock\" schX={5} schY={5} />\n+    <pushbutton name=\"SW_BOOT\" footprint=\"pushbutton\" pcbX={-13.5} pcbY={16.5} schSectionName=\"Flash and Clock\" schX={7} schY={5} />\n+\n+    <resistor name=\"R_LED\" resistance=\"1k\" footprint=\"0402\" pcbX={9.5} pcbY={8.5} schSectionName=\"RP2040\" schX={3} schY={2} />\n+    <led name=\"D_LED\" footprint=\"0603\" color=\"green\" pcbX={13} pcbY={8.5} schSectionName=\"RP2040\" schX={5} schY={2} />\n+\n+    <silkscreentext text=\"RP2040 USB BREAKOUT\" 