[recv] {"method":"item/started","params":{"item":{"type":"fileChange","id":"call_pCnxNWsz4Y6itAY7KXjqMQTr","changes":[{"path":"/workspace/index.circuit.tsx","kind":{"type":"add"},"diff":"import { AP2112K_3_3TRG1 } from \"./imports/AP2112K_3_3TRG1\"\nimport { RP2040 } from \"./imports/RP2040\"\nimport { W25Q32JVSSIQ } from \"./imports/W25Q32JVSSIQ\"\n\nconst gpioHeaderLeft = [\n  \"GPIO0\",\n  \"GPIO1\",\n  \"GPIO2\",\n  \"GPIO3\",\n  \"GPIO4\",\n  \"GPIO5\",\n  \"GPIO6\",\n  \"GPIO7\",\n  \"GND\",\n  \"V3_3\",\n]\n\nconst gpioHeaderRight = [\n  \"GPIO8\",\n  \"GPIO9\",\n  \"GPIO10\",\n  \"GPIO11\",\n  \"GPIO12\",\n  \"GPIO13\",\n  \"GPIO14\",\n  \"GPIO15\",\n  \"RUN\",\n  \"VBUS\",\n]\n\nexport default () => (\n  <board width=\"44mm\" height=\"30mm\" layers={2}>\n    <RP2040 name=\"U1\" pcbX={0} pcbY={0} schX={0} schY={0} />\n\n    <W25Q32JVSSIQ\n      name=\"U2\"\n      pcbX={0}\n      pcbY={9.5}\n      pcbRotation={180}\n      schX={6}\n      schY={0}\n    />\n\n    <AP2112K_3_3TRG1\n      name=\"U3\"\n      pcbX={-11}\n      pcbY={-7.5}\n      pcbRotation={180}\n      schX={-6}\n      schY={4}\n    />\n\n    <connector\n      name=\"J1\"\n      standard=\"usb_c\"\n      pcbX={0}\n      pcbY={-14}\n      pcbRotation={180}\n      schX={-6}\n      schY={-2}\n    />\n\n    <pinheader\n      name=\"J2\"\n      pinCount={10}\n      pitch=\"2.54mm\"\n      gender=\"female\"\n      pinLabels={gpioHeaderLeft}\n      showSilkscreenPinLabels\n      footprint=\"pinrow10\"\n      pcbX={-18}\n      pcbY={0}\n      pcbRotation={90}\n      schX={-8}\n      schY={-6}\n    />\n\n    <pinheader\n      name=\"J3\"\n      pinCount={10}\n      pitch=\"2.54mm\"\n      gender=\"female\"\n      pinLabels={gpioHeaderRight}\n      showSilkscreenPinLabels\n      footprint=\"pinrow10\"\n      pcbX={18}\n      pcbY={0}\n      pcbRotation={90}\n      schX={8}\n      schY={-6}\n    />\n\n    <led\n      name=\"D1\"\n      color=\"green\"\n      footprint=\"0603\"\n      pcbX={10.5}\n      pcbY={8.5}\n      schX={4}\n      schY={5}\n    />\n    <resistor\n      name=\"R1\"\n      resistance=\"1k\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C21190\" }}\n      pcbX={7.5}\n      pcbY={8.5}\n      schX={2.5}\n      schY={5}\n    />\n\n    <resistor\n      name=\"R2\"\n      resistance=\"5.1k\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C23186\" }}\n      pcbX={-6.5}\n      pcbY={-11}\n      schX={-8}\n      schY={-4}\n    />\n    <resistor\n      name=\"R3\"\n      resistance=\"5.1k\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C23186\" }}\n      pcbX={6.5}\n      pcbY={-11}\n      schX={-4}\n      schY={-4}\n    />\n\n    <crystal\n      name=\"Y1\"\n      frequency=\"12MHz\"\n      loadCapacitance=\"12pF\"\n      footprint=\"hc49\"\n      pcbX={-10}\n      pcbY={7.5}\n      schX={-4}\n      schY={5}\n    />\n    <capacitor\n      name=\"C1\"\n      capacitance=\"18pF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C1648\" }}\n      pcbX={-14}\n      pcbY={6}\n      schX={-6}\n      schY={6}\n    />\n    <capacitor\n      name=\"C2\"\n      capacitance=\"18pF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C1648\" }}\n      pcbX={-14}\n      pcbY={9}\n      schX={-2}\n      schY={6}\n    />\n\n    <capacitor\n      name=\"C3\"\n      capacitance=\"1uF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C15849\" }}\n      pcbX={-13.5}\n      pcbY={-10.5}\n      schX={-8}\n      schY={2}\n    />\n    <capacitor\n      name=\"C4\"\n      capacitance=\"1uF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C15849\" }}\n      pcbX={-8.5}\n      pcbY={-10.5}\n      schX={-4}\n      schY={2}\n    />\n    <capacitor\n      name=\"C5\"\n      capacitance=\"100nF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C14663\" }}\n      pcbX={-5}\n      pcbY={5.5}\n      schX={-2}\n      schY={2}\n    />\n    <capacitor\n      name=\"C6\"\n      capacitance=\"1uF\"\n      footprint=\"0603\"\n      supplierPartNumbers={{ jlcpcb: \"C15849\" }}\n      pcbX={5}\n      pcbY={5.5}\n      schX={2}\n      schY={2}\n    />\n\n    <pushbutton\n      name=\"SW1\"\n      footprint=\"pushbutton\"\n      pcbX={-15}\n      pcbY={12}\n      schX={-6}\n      schY={7}\n    />\n    <pushbutton\n      name=\"SW2\"\n      footprint=\"pushbutton\"\n      pcbX={15}\n      pcbY={12}\n      schX={6}\n      schY={7}\n    />\n\n    <silkscreentext text=\"RP2040 USB BREAKOUT\" pcbX={0} pcbY={13.2} fontSize={1} />\n    <silkscreentext text=\"BOOT\" pcbX={-15} pcbY={9.5} fontSize={0.7} />\n    <silkscreentext text=\"RUN\" pcbX={15} pcbY={9.5} fontSize={0.7} />\n\n    <trace from=\".J1 > .VBUS\" to=\"net.VBUS\" width=\"0.35mm\" />\n    <trace from=\".J1 > .GND\" to=\"net.GND\" width=\"0.35mm\" />\n    <trace from=\".J1 > .D_N\" to=\".U1 > .USB_DM\" width=\"0.18mm\" />\n    <trace from=\".J1 > .D_P\" to=\".U1 > .USB_DP\" width=\"0.18mm\" />\n    <trace from=\".J1 > .CC1\" to=\".R2 > .pin1\" />\n    <trace from=\".J1 > .CC2\" to=\".R3 > .pin1\" />\n    <trace from=\".R2 > .pin2\" to=\"net.GND\" />\n    <trace from=\".R3 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U3 > .VIN\" to=\"net.VBUS\" width=\"0.35mm\" />\n    <trace from=\".U3 > .EN\" to=\"net.VBUS\" />\n    <trace from=\".U3 > .GND\" to=\"net.GND\" />\n    <trace from=\".U3 > .VOUT\" to=\"net.V3_3\" width=\"0.35mm\" />\n    <trace from=\".C3 > .pin1\" to=\"net.VBUS\" />\n    <trace from=\".C3 > .pin2\" to=\"net.GND\" />\n    <trace from=\".C4 > .pin1\" to=\"net.V3_3\" />\n    <trace from=\".C4 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .VREG_IN\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .VREG_VOUT\" to=\".C6 > .pin1\" />\n    <trace from=\".C6 > .pin2\" to=\"net.GND\" />\n    <trace from=\".U1 > .USB_VDD\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .ADC_AVDD\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .GND\" to=\"net.GND\" />\n    <trace from=\".U1 > .DVDD1\" to=\"net.GND\" />\n    <trace from=\".U1 > .DVDD2\" to=\"net.GND\" />\n    <trace from=\".C5 > .pin1\" to=\"net.V3_3\" />\n    <trace from=\".C5 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .IOVDD1\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .IOVDD2\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .IOVDD3\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .IOVDD4\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .IOVDD5\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .IOVDD6\" to=\"net.V3_3\" />\n    <trace from=\".U1 > .TESTEN\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .XIN\" to=\".Y1 > .pin1\" />\n    <trace from=\".U1 > .XOUT\" to=\".Y1 > .pin2\" />\n    <trace from=\".Y1 > .pin1\" to=\".C1 > .pin1\" />\n    <trace from=\".Y1 > .pin2\" to=\".C2 > .pin1\" />\n    <trace from=\".C1 > .pin2\" to=\"net.GND\" />\n    <trace from=\".C2 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .QSPI_SS\" to=\".U2 > .CS\" />\n    <trace from=\".U1 > .QSPI_SD0\" to=\".U2 > .pin5\" />\n    <trace from=\".U1 > .QSPI_SD1\" to=\".U2 > .pin2\" />\n    <trace from=\".U1 > .QSPI_SD2\" to=\".U2 > .pin3\" />\n    <trace from=\".U1 > .QSPI_SD3\" to=\".U2 > .pin7\" />\n    <trace from=\".U1 > .QSPI_SCLK\" to=\".U2 > .CLK\" />\n    <trace from=\".U2 > .VCC\" to=\"net.V3_3\" />\n    <trace from=\".U2 > .GND\" to=\"net.GND\" />\n    <trace from=\".SW1 > .pin1\" to=\".U2 > .CS\" />\n    <trace from=\".SW1 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".SW2 > .pin1\" to=\".U1 > .RUN\" />\n    <trace from=\".SW2 > .pin2\" to=\"net.GND\" />\n\n    <trace from=\".U1 > .GPIO25\" to=\".R1 > .pin1\" />\n    <trace from=\".R1 > .pin2\" to=\".D1 > .anode\" />\n    <trace from=\".D1 > .cathode\" to=\"net.GND\" />\n\n    {gpioHeaderLeft.slice(0, 8).map((label) => (\n      <trace key={label} from={`.U1 > .${label}`} to={`.J2 > .${label}`} />\n    ))}\n    <trace from=\".J2 > .GND\" to=\"net.GND\" />\n    <trace from=\".J2 > .V3_3\" to=\"net.V3_3\" />\n\n    {gpioHeader