     pcbY={13}\n+      schX={8}\n+      schY={3}\n+    />\n+\n+    <capacitor\n+      name=\"C_IN\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      pcbX={-14.5}\n+      pcbY={-10.5}\n+      schX={-6}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_OUT\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      pcbX={-8}\n+      pcbY={-12}\n+      schX={-2}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_VREG\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      pcbX={6}\n+      pcbY={2.4}\n+      schX={1}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_USB\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      pcbX={6}\n+      pcbY={4.2}\n+      schX={2.5}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC1\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      pcbX={-6}\n+      pcbY={-4.8}\n+      schX={0}\n+      schY={5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC2\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      pcbX={6}\n+      pcbY={-4.8}\n+      schX={1.5}\n+      schY={5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_XIN\"\n+      capacitance=\"18pF\"\n+      footprint=\"0402\"\n+      pcbX={-10.5}\n+      pcbY={5.5}\n+      schX={-6}\n+      schY={-5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_XOUT\"\n+      capacitance=\"18pF\"\n+      footprint=\"0402\"\n+      pcbX={-10.5}\n+      pcbY={8.5}\n+      schX={-4}\n+      schY={-5}\n+      schRotation={90}\n+    />\n+\n+    <pushbutton\n+      name=\"SW_BOOT\"\n+      footprint=\"pushbutton\"\n+      pcbX={3}\n+      pcbY={19}\n+      schX={8}\n+      schY={-2}\n+    />\n+    <pushbutton\n+      name=\"SW_RUN\"\n+      footprint=\"pushbutton\"\n+      pcbX={12}\n+      pcbY={19}\n+      schX={8}\n+      schY={-4}\