RUN\",\n+] as const\n+\n export default () => (\n-  <board>\n-    <resistor resistance=\"1k\" footprint=\"0402\" name=\"R1\" />\n-    <capacitor capacitance=\"1000pF\" footprint=\"0402\" name=\"C1\" />\n-    <trace from=\".R1 > .pin1\" to=\".C1 > .pin1\" />\n+  <board width=\"42mm\" height=\"50mm\" layers={2}>\n+    <RP2040\n+      name=\"U1\"\n+      pcbX={0}\n+      pcbY={0}\n+      schX={0}\n+      schY={0}\n+      schPinArrangement={{\n+        leftSide: {\n+          pins: [\n+            \"GPIO0\",\n+            \"GPIO1\",\n+            \"GPIO2\",\n+            \"GPIO3\",\n+            \"GPIO4\",\n+            \"GPIO5\",\n+            \"GPIO6\",\n+            \"GPIO7\",\n+            \"GPIO8\",\n+            \"GPIO9\",\n+            \"GPIO10\",\n+            \"GPIO11\",\n+            \"GPIO12\",\n+            \"GPIO13\",\n+            \"GPIO14\",\n+            \"GPIO15\",\n+            \"XIN\",\n+            \"XOUT\",\n+          ],\n+          direction: \"top-to-bottom\",\n+        },\n+        rightSide: {\n+          pins: [\n+            \"GPIO16\",\n+            \"GPIO17\",\n+            \"GPIO18\",\n+            \"GPIO19\",\n+            \"GPIO20\",\n+            \"GPIO21\",\n+            \"GPIO22\",\n+            \"GPIO23\",\n+            \"GPIO24\",\n+            \"GPIO25\",\n+            \"GPIO26_ADC0\",\n+            \"GPIO27_ADC1\",\n+            \"GPIO28_ADC2\",\n+            \"GPIO29_ADC3\",\n+            \"USB_DM\",\n+            \"USB_DP\",\n+            \"RUN\",\n+            \"SWD\",\n+            \"SWCLK\",\n+          ],\n+          direction: \"top-to-bottom\",\n+        },\n+        topSide: {\n+          pins: [\n+            \"IOVDD1\",\n+            \"IOVDD2\",\n+            \"IOVDD3\",\n+            \"IOVDD4\",\n+            \"IOVDD5\",\n+            \"IOVDD6\",\n+            \"ADC_AVDD\",\n+            \"USB_VDD\",\n+            \"VREG_IN\",\n+            \"VREG_VOUT\",\n+            \"DVDD1\",\n+            \"DVDD2\",\n+          ],\n+          direction: \"left-to-right\",\n+        },\n+        bottomSide: {\n+          pins: [\n+            \"QSPI_SS\",\n+            \"QSPI_SD0\",\n+            \"QSPI_SD1\",\n+            \"QSPI_SD2\",\n+            \"QSPI_SD3\",\n+            \"QSPI_SCLK\",\n+            \"TESTEN\",\n+            \"GND\",\n+          ],\n+          direction: \"left-to-right\",\n+        },\n+      }}\n+    />\n+\n+    <connector\n+      name=\"J_USB\"\n+      standard=\"usb_c\"\n+      pcbX={0}\n+      pcbY={-21}\n+      pcbRotation={0}\n+      schX={-8}\n+      schY={4}\n+      schWidth={0.85}\n+    />\n+\n+    <chip\n+      name=\"U2\"\n+      manufacturerPartNumber=\"AP2112K-3.3\"\n+      supplierPartNumbers={{ jlcpcb: [\"C51118\"] }}\n+      footprint=\"sot23_5\"\n+      pinLabels={{\n+        pin1: \"IN\",\n+        pin2: \"GND\",\n+        pin3: \"EN\",\n+        pin4: \"NC\",\n+        pin5: \"OUT\",\n+      }}\n+      schPinArrangement={{\n+        leftSide: { pins: [\"IN\", \"EN\"], direction: \"top-to-bottom\" },\n+        rightSide: { pins: [\"OUT\"], direction: \"top-to-bottom\" },\n+        bottomSide: { pins: [\"GND\", \"NC\"], direction: \"left-to-right\" },\n+      }}\n+      pcbX={-12}\n+      pcbY={-14}\n+      schX={-4}\n+      schY={4}\n+      schWidth={0.6}\n+      schHeight={0.4}\n+    />\n+\n+    <chip\n+      name=\"U3\"\n+      manufacturerPartNumber=\"W25Q16JVUXIQ\"\n+      supplierPartNumbers={{ jlcpcb: [\"C2846332\"] }}\n+      footprint=\"wson8_2x3mm\"\n+      pinLabels={{\n+        pin1: \"CS\",\n+        pin2: \"DO\",\n+        pin3: \"WP\",\n+        pin4: \"GND\",\n+        pin5: \"DI\",\n+        pin6: \"CLK\",\n+        pin7: \"HOLD\",\n+        pin8: \"VCC\",\n+      }}\n+      schPinArrangement={{\n+        leftSide: { pins: [\"CS\", \"DO\", \"WP\", \"GND\"], direction: \"top-to-bottom\" },\n+        rightSide: { pins: [\"VCC\", \"HOLD\", \"CLK\", \"DI\"], direction: \"top-to-bottom\" },\n+      }}\n+      pcbX={0}\n+      pcbY={9}\n+      schX={4}\n+      schY={-4}\n+    />\n+\n+    <crystal\n+      name=\"Y1\"\n+      frequency=\"12MHz\"\n+      loadCapacitance=\"12pF\"\n+      footprint=\"crystal_3225\"\n+      manufacturerPartNumber=\"X322512MSB4SI\"\n+      supplierPartNumbers={{ jlcpcb: [\"C9002\"] }}\n+      pcbX={-8}\n+      pcbY={7}\n+      schX={-5}\n+      schY={-3}\n+    />\n+\n+    <pinheader\n+      name=\"J_LEFT\"\n+      pinCount={leftHeaderPins.length}\n+      gender=\"female\"\n+      pitch=\"2.54mm\"\n+      footprint=\"pinrow16\"\n+      pinLabels={[...leftHeaderPins]}\n+      showSilkscreenPinLabels\n+      pcbX={-18.5}\n+      pcbY={0}\n+      pcbRotation={90}\n+      schX={-10}\n+      schY={-3}\n+      schWidth={0.77}\n+    />\n+\n+    <pinheader\n+      name=\"J_RIGHT\"\n+      pinCount={rightHeaderPins.length}\n+      gender=\"female\"\n+      pitch=\"2.54mm\"\n+      footprint=\"pinrow16\"\n+      pinLabels={[...rightHeaderPins]}\n+      showSilkscreenPinLabels\n+      pcbX={18.5}\n+      pcbY={0}\n+      pcbRotation={90}\n+      schX={10}\n+      schY={-3}\n+      schWidth={1.245}\n+    />\n+\n+    <resistor\n+      name=\"R_DP\"\n+      resistance=\"27ohm\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C25187\"] }}\n+      pcbX={4.4}\n+      pcbY={-15.5}\n+      schX={-4}\n+      schY={1.2}\n+    />\n+    <resistor\n+      name=\"R_DM\"\n+      resistance=\"27ohm\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C25187\"] }}\n+      pcbX={2}\n+      pcbY={-15.5}\n+      schX={-4}\n+      schY={0}\n+    />\n+    <resistor\n+      name=\"R_CC1\"\n+      resistance=\"5.1kohm\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C25905\"] }}\n+      pcbX={-5}\n+      pcbY={-16}\n+      schX={-9}\n+      schY={1}\n+    />\n+    <resistor\n+      name=\"R_CC2\"\n+      resistance=\"5.1kohm\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C25905\"] }}\n+      pcbX={-7}\n+      pcbY={-16}\n+      schX={-9}\n+      schY={0}\n+    />\n+    <resistor\n+      name=\"R_LED\"\n+      resistance=\"1kohm\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C21190\"] }}\n+      pcbX={8}\n+      pcbY={13}\n+      schX={6}\n+      schY={3}\n+    />\n+\n+    <led\n+      name=\"D1\"\n+      color=\"green\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C72043\"] }}\n+      pcbX={11}\n+      pcbY={13}\n+      schX={8}\n+      schY={3}\n+    />\n+\n+    <capacitor\n+      name=\"C_IN\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C19702\"] }}\n+      pcbX={-14.5}\n+      pcbY={-10.5}\n+      schX={-6}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_OUT\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C19702\"] }}\n+      pcbX={-8}\n+      pcbY={-12}\n+      schX={-2}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_VREG\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C52923\"] }}\n+      pcbX={6}\n+      pcbY={2.4}\n+      schX={1}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_USB\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C52923\"] }}\n+      pcbX={6}\n+      pcbY={4.2}\n+      schX={2.5}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC1\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C1525\"] }}\n+      pcbX={-6}\n+      pcbY={-4.8}\n+      schX={0}\n+      schY={5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC2\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C1525\"] }}\n+      pcbX={6}\n+      pcbY={-4.8}\n+      schX={1.5}\n+      schY