schX={-9}\n+      schY={0}\n+    />\n+    <resistor\n+      name=\"R_LED\"\n+      resistance=\"1kohm\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C21190\"] }}\n+      pcbX={8}\n+      pcbY={13}\n+      schX={6}\n+      schY={3}\n+    />\n+\n+    <led\n+      name=\"D1\"\n+      color=\"green\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C72043\"] }}\n+      pcbX={11}\n+      pcbY={13}\n+      schX={8}\n+      schY={3}\n+    />\n+\n+    <capacitor\n+      name=\"C_IN\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C19702\"] }}\n+      pcbX={-16}\n+      pcbY={-12}\n+      schX={-6}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_OUT\"\n+      capacitance=\"10uF\"\n+      footprint=\"0603\"\n+      supplierPartNumbers={{ jlcpcb: [\"C19702\"] }}\n+      pcbX={-8}\n+      pcbY={-12}\n+      schX={-2}\n+      schY={6}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_VREG\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C52923\"] }}\n+      pcbX={6}\n+      pcbY={2.4}\n+      schX={1}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_USB\"\n+      capacitance=\"1uF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C52923\"] }}\n+      pcbX={6}\n+      pcbY={4.2}\n+      schX={2.5}\n+      schY={3.5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC1\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C1525\"] }}\n+      pcbX={-6}\n+      pcbY={-4.8}\n+      schX={0}\n+      schY={5}\n+      schRotation={90}\n+    />\n+    <capacitor\n+      name=\"C_DEC2\"\n+      capacitance=\"100nF\"\n+      footprint=\"0402\"\n+      supplierPartNumbers={{ jlcpcb: [\"C1525\"] }}\n+      pcbX={6}\n+      pcbY={-4.8}\n+      schX={1.5}\n+      schY={5}\n+